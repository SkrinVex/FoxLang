// Ввод: строки берутся из поля «Ввод программы» под выводом.
string name = input("Как тебя зовут? ");
print("Приятно познакомиться, ${name}!");

int sum = 0;
int count = 0;
while (true) {
    string line = input("Число (пустая строка, чтобы закончить): ");
    if (line == "") {
        break;
    }
    sum += to_int(line);
    count++;
}
print("Чисел: ${count}, сумма: ${sum}");
