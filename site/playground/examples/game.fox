// Игра: стрелками или мышью веди лису к звёздам. Щёлкни по окну, чтобы оно
// получало клавиши. На телефоне: веди пальцем или жми стрелки под окном.
using graphics;

int width = 480;
int height = 320;
open_window(width, height, "Лиса и звёзды");

float x = 240;
float y = 160;
float speed = 180;
int starX = random(20, width - 20);
int starY = random(40, height - 20);
int score = 0;

while (window_poll()) {
    float dt = frame_delta();
    if (key_down("LEFT") || key_down("A")) { x -= speed * dt; }
    if (key_down("RIGHT") || key_down("D")) { x += speed * dt; }
    if (key_down("UP") || key_down("W")) { y -= speed * dt; }
    if (key_down("DOWN") || key_down("S")) { y += speed * dt; }
    if (key_down("MOUSE_LEFT")) {
        // Лиса бежит к курсору.
        x += (mouse_x() - x) * 4 * dt;
        y += (mouse_y() - y) * 4 * dt;
    }
    x = clamp(x, 12, width - 12);
    y = clamp(y, 30, height - 12);

    float dx = x - starX;
    float dy = y - starY;
    if (dx * dx + dy * dy < 22 * 22) {
        score++;
        starX = random(20, width - 20);
        starY = random(40, height - 20);
    }

    clear_window(rgb(24, 34, 52));
    for (int i = 0; i < 40; i++) {
        draw_rect((i * 97) % width, (i * 53) % height, 2, 2, rgb(90, 110, 150));
    }
    draw_circle(starX, starY, 9, rgb(255, 214, 90));
    draw_circle(to_int(x), to_int(y), 12, rgb(255, 138, 51));
    draw_circle(to_int(x) - 5, to_int(y) - 3, 2, rgb(30, 30, 30));
    draw_circle(to_int(x) + 5, to_int(y) - 3, 2, rgb(30, 30, 30));
    draw_rect(0, 0, width, 24, rgb(14, 20, 32));
    draw_text(8, 6, "Звёзды: " + score, 2, rgb(255, 255, 255));
    present_window();
}
close_window();
