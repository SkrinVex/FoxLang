// Привет! Это FoxLang. Нажми «Запустить» или Ctrl+Enter.
string name = "мир";
print("Привет, ${name}! 🦊");

// Переменные с типами: int, float, string, bool.
int year = 2026;
float pi = 3.14159;
bool fox = true;
print("Год: " + year + ", пи ≈ " + pi + ", лис: " + fox);

// Циклы и условия.
for (int i = 1; i <= 15; i++) {
    if (i % 15 == 0) {
        print("FizzBuzz");
    } else if (i % 3 == 0) {
        print("Fizz");
    } else if (i % 5 == 0) {
        print("Buzz");
    } else {
        print(i);
    }
}
