// Файловый браузер: список с правами, размерами и датами, двойной щелчок и Enter
// открывают каталог или файл, колесо и стрелки прокручивают, диалоги «Перейти» и
// «Новая папка» блокируют окно под собой. Список прокручивается колесом и ползунком.
//   foxlang examples/file_browser.fox [каталог]
using graphics;
using ui;
using fs;
using os;
using string;
using time;

string current = absolute_path(arg_or(0, cwd()));
array names;
int selected = 0;
int scroll = 0;
string status = "";
int dialog = 0; // 0 — нет, 1 — перейти, 2 — новая папка
string input = "";

void load(string path) {
    if (!is_dir(path)) {
        status = "Нет такого каталога: " + path;
        return;
    }
    current = absolute_path(path);
    names = list_dir(current);
    selected = 0;
    scroll = 0;
    status = "" + size(names) + " объектов, свободно " + format_bytes(free_space(current));
}

void open_selected() {
    if (size(names) == 0) {
        return;
    }
    string target = join_path(current, names[selected]);
    if (is_dir(target)) {
        load(target);
    } else if (!open_path(target)) {
        status = "Не удалось открыть " + names[selected];
    }
}

int list_top = 60;
int row_height = 24;
int list_height = 384;

void draw_list() {
    int count = size(names);
    scroll = ui_scroll_begin("list", 10, list_top, 780, list_height, scroll, count * row_height);
    draw_rect(10, list_top, 768, list_height, rgb(255, 255, 255));
    // Рисуются только строки, попадающие в область, даже в каталоге на тысячи файлов.
    int first = scroll / row_height;
    for (int index = first; index < count && index * row_height - scroll < list_height; index++) {
        int y = list_top + index * row_height - scroll;
        string path = join_path(current, names[index]);
        if (ui_click("row" + index, 10, y, 768, row_height)) {
            selected = index;
        }
        if (ui_double_click("row" + index, 10, y, 768, row_height)) {
            ui_scroll_end();
            open_selected();
            return;
        }
        if (index == selected) {
            draw_rect(10, y, 768, row_height, rgb(205, 226, 252));
        } else if (ui_hover("row" + index, 10, y, 768, row_height)) {
            draw_rect(10, y, 768, row_height, rgb(238, 244, 254));
        }
        int kind_color = rgb(85, 100, 115);
        string kind = "[F]";
        string size_text = format_bytes(file_size(path));
        if (is_dir(path)) {
            kind = "[D]";
            kind_color = rgb(225, 145, 20);
            size_text = "";
        } else if (is_executable(path)) {
            kind = "[*]";
            kind_color = rgb(35, 140, 55);
        }
        draw_text(18, y + 8, kind, 1, kind_color);
        draw_text(48, y + 8, substring(names[index], 0, 48), 1, rgb(30, 35, 42));
        draw_text(360, y + 8, permissions(path), 1, rgb(112, 120, 130));
        draw_text(450, y + 8, owner(path), 1, rgb(112, 120, 130));
        draw_text(560, y + 8, size_text, 1, rgb(30, 35, 42));
        draw_text(660, y + 8, days_ago(modified_ms(path)), 1, rgb(112, 120, 130));
    }
    ui_scroll_end();
}

string days_ago(float stamp) {
    if (stamp < 0) {
        return "";
    }
    int days = to_int((unix_time_ms() - stamp) / 86400000);
    if (days == 0) {
        return "сегодня";
    }
    return "" + days + " дн. назад";
}

void draw_dialogs() {
    if (dialog == 0) {
        return;
    }
    string title = "Перейти в каталог";
    string hint = "/home или ~/projects";
    if (dialog == 2) {
        title = "Новая папка";
        hint = "Имя папки";
    }
    ui_modal_begin(200, 180, 400, 150, title);
    input = ui_text_field("dialog-input", 220, 230, 360, input, hint);
    bool accept = ui_primary_button("dialog-ok", 400, 280, 90, 28, "ОК");
    if (accept || (ui_focused("dialog-input") && key_pressed("ENTER"))) {
        if (dialog == 1) {
            string target = input;
            if (starts_with(target, "~")) {
                target = home_dir() + substring(target, 1, length(target));
            }
            load(target);
        } else if (make_dir(join_path(current, input))) {
            load(current);
        } else {
            status = "Не удалось создать " + input;
        }
        dialog = 0;
    }
    if (ui_button("dialog-cancel", 500, 280, 80, 28, "Отмена") || key_pressed("ESCAPE")) {
        dialog = 0;
    }
    ui_modal_end();
}

void handle_keys() {
    // Пока в поле идёт ввод или открыт диалог, буквы — это текст, а не команды.
    if (dialog != 0 || ui_typing()) {
        return;
    }
    bool moved = false;
    if (key_repeat("DOWN") && selected + 1 < size(names)) {
        selected++;
        moved = true;
    }
    if (key_repeat("UP") && selected > 0) {
        selected--;
        moved = true;
    }
    if (moved) {
        scroll = ui_scroll_to(scroll, selected * row_height, (selected + 1) * row_height, list_height);
    }
    if (key_pressed("ENTER")) {
        open_selected();
    }
    if (key_pressed("BACKSPACE")) {
        load(parent_dir(current));
    }
}

void main() {
    load(current);
    open_window(800, 500, "FoxLang: файлы");
    while (window_poll()) {
        if (key_pressed("ESCAPE") && dialog == 0) {
            break;
        }
        handle_keys();
        clear_window(rgb(244, 246, 249));
        if (ui_button("up", 10, 12, 60, 30, "Вверх")) {
            load(parent_dir(current));
        }
        if (ui_button("goto", 80, 12, 90, 30, "Перейти")) {
            dialog = 1;
            input = current;
            ui_focus("dialog-input");
        }
        if (ui_button("mkdir", 180, 12, 110, 30, "Новая папка")) {
            dialog = 2;
            input = "";
            ui_focus("dialog-input");
        }
        draw_text(300, 24, substring(current, 0, 60), 1, rgb(30, 35, 42));
        draw_list();
        draw_text(10, 460, status, 1, rgb(112, 120, 130));
        draw_dialogs();
        present_window();
        wait(16);
    }
    close_window();
}

main();
