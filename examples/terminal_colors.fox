// Цвета и курсор терминала через модуль terminal.
using terminal;
using time;

void main() {
    clear();
    hide_cursor();
    array colors = [31, 33, 32, 36, 34, 35];
    for (int i = 0; i < size(colors); i++) {
        goto_xy(2 + i, 4 + i * 2);
        color(colors[i]);
        write("FoxLang 🦊");
        sleep_ms(120);
    }
    reset_color();
    goto_xy(9, 1);
    show_cursor();
}

main();
