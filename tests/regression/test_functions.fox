// FoxLang regression: functions, params, return, recursion, local scope
void assert_true(bool cond, string msg) {
    if (!cond) {
        print("FAIL: " + msg);
        exit(1);
    }
}

// 1. Basic function
int add3(int a, int b, int c) {
    return a + b + c;
}
assert_true(add3(10, 20, 30) == 60, "add3 function");

// 2. String return function
string greet(string name, string title) {
    return "Hello " + title + " " + name;
}
assert_true(greet("Fox", "Dr.") == "Hello Dr. Fox", "greet function");

// 3. Recursion
int fib(int n) {
    if (n <= 0) { return 0; }
    if (n == 1) { return 1; }
    return fib(n - 1) + fib(n - 2);
}
assert_true(fib(7) == 13, "fibonacci recursion");

// 4. Local scope isolation
int shadow = 100;
void test_scope() {
    int shadow = 200;
    shadow = shadow + 1;
}
test_scope();
assert_true(shadow == 100, "local variable shadow does not overwrite outer");

// 5. A function and a struct type exist before the lines that define them
assert_true(later(4) == 40, "call before the definition");
Pair early = Pair(1, 2);
assert_true(early.a + early.b == 3, "struct used before its definition");
int later(int x) {
    return x * 10;
}
struct Pair {
    int a;
    int b;
}

// 6. A name that exists keeps its meaning until the new definition runs
int version() { return 1; }
assert_true(version() == 1, "first definition");
int version() { return 2; }
assert_true(version() == 2, "redefinition takes effect where it stands");

print("FUNCTIONS_OK");
