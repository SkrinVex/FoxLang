// FoxLang regression: environment variables and secrets
using env;

void assert_true(bool cond, string msg) {
    if (!cond) {
        print("FAIL: " + msg);
        exit(1);
    }
}

// 1. env() for existing variable
string path_val = env("PATH");
assert_true(size(path_val) > 0, "env(PATH) is not empty");

// 2. env() for non-existent variable returns empty string
string missing_val = env("NON_EXISTENT_VAR_XYZ_123");
assert_true(missing_val == "", "env(non_existent) returns empty string");

// 3. secret() for existing variable
string secret_val = secret("PATH");
assert_true(secret_val == path_val, "secret(PATH) equals env(PATH)");

// 4. env_default() for existing and non-existing variables
string def1 = env_default("PATH", "default_path");
assert_true(def1 == path_val, "env_default with existing var");

string def2 = env_default("NON_EXISTENT_VAR_XYZ_123", "fallback_8080");
assert_true(def2 == "fallback_8080", "env_default with missing var");

// 5. set_env() changes the environment of this process
assert_true(set_env("FOXLANG_REGRESSION_VALUE", "лис 🦊"), "set_env succeeds");
assert_true(env("FOXLANG_REGRESSION_VALUE") == "лис 🦊", "set_env is visible to env()");
assert_true(!set_env("", "x"), "set_env rejects an empty name");

print("ENV_OK");
