// FoxLang regression: advanced JSON parsing and escaping
using json;

void assert_true(bool cond, string msg) {
    if (!cond) {
        print("FAIL: " + msg);
        exit(1);
    }
}

// 1. Telegram-style payload
string tg_json = "{"
    "\"update_id\": 10001,"
    "\"message\": {"
        "\"message_id\": 42,"
        "\"from\": {"
            "\"id\": 999,"
            "\"is_bot\": false,"
            "\"first_name\": \"Иван\","
            "\"username\": \"ivan_fox\""
        "},"
        "\"chat\": {"
            "\"id\": -100123456,"
            "\"type\": \"supergroup\""
        "},"
        "\"text\": \"Привет, мир! 🦊\","
        "\"date\": 1700000000"
    "}"
    "}";

assert_true(json_path(tg_json, "update_id") == "10001", "tg update_id");
assert_true(json_path(tg_json, "message.message_id") == "42", "tg message.message_id");
assert_true(json_path(tg_json, "message.chat.id") == "-100123456", "tg message.chat.id");
assert_true(json_path(tg_json, "message.from.first_name") == "Иван", "tg message.from.first_name");
assert_true(json_path(tg_json, "message.from.username") == "ivan_fox", "tg message.from.username");
assert_true(json_path(tg_json, "message.text") == "Привет, мир! 🦊", "tg message.text");

// 2. Escape sequences: quotes, backslashes, newlines
string esc_json = "{\"str\": \"line1\\nline2\\twith \\\"quotes\\\" and \\\\backslash\\\\\"}";
string decoded_str = json_path(esc_json, "str");
assert_true(decoded_str == "line1\nline2\twith \"quotes\" and \\backslash\\", "json escape sequences");

// 3. Unicode escape \uXXXX and Cyrillic
string uni_json = "{\"greeting\": \"\\u041f\\u0440\\u0438\\u0432\\u0435\\u0442\"}";
assert_true(json_path(uni_json, "greeting") == "Привет", "unicode cyrillic escape");

// 4. UTF-16 surrogate pairs for emoji (e.g. \uD83E\uDD8A for 🦊)
string emoji_json = "{\"emoji\": \"\\uD83E\\uDD8A\"}";
assert_true(json_path(emoji_json, "emoji") == "🦊", "unicode emoji surrogate pair");

// 5. JSON escaping helper
string raw_text = "Hello \"World\"\nNew\tLine\\Backslash";
string safe = json_safe(raw_text);
assert_true(safe == "Hello \\\"World\\\"\\nNew\\tLine\\\\Backslash", "json_safe output");

// 6. Deeply nested object
string deep_json = "{\"a\":{\"b\":{\"c\":{\"d\":999}}}}";
assert_true(json_path(deep_json, "a.b.c.d") == "999", "deeply nested path");

// 7. Non-existent path returns empty string
assert_true(json_path(deep_json, "a.b.nonexistent") == "", "missing path returns empty");

// 8. Arrays: indexes in the path, counts and types
string list_json = "{\"items\": [{\"name\": \"a\"}, {\"name\": \"б🦊\", \"tags\": [1, 2, 3]}], \"empty\": [], \"none\": null, \"ok\": true}";
assert_true(json_path(list_json, "items.1.name") == "б🦊", "array index in a path");
assert_true(json_path(list_json, "items[1].tags[2]") == "3", "bracket indexes");
assert_true(json_path(list_json, "items.5.name") == "", "index past the end");
assert_true(json_count_at(list_json, "items") == 2 && json_count_at(list_json, "items.1.tags") == 3, "json_count of arrays");
assert_true(json_count_at(list_json, "") == 4 && json_count_at(list_json, "empty") == 0, "json_count of objects and empty arrays");
assert_true(json_count_at(list_json, "ok") == -1 && json_count_at(list_json, "missing") == -1, "json_count of scalars and missing paths");
assert_true(json_type_at(list_json, "items") == "array" && json_type_at(list_json, "items.0") == "object", "json_type containers");
assert_true(json_type_at(list_json, "ok") == "bool" && json_type_at(list_json, "none") == "null", "json_type literals");
assert_true(json_type_at(list_json, "items.0.name") == "string" && json_type_at(list_json, "items.1.tags.0") == "number", "json_type values");
assert_true(json_type_at(list_json, "nope") == "", "json_type of a missing path");
assert_true(json_path(list_json, "items.1.tags") == "[1, 2, 3]", "containers come back as JSON text");

// 9. Iterating an array
int total = 0;
for (int i = 0; i < json_count_at(list_json, "items.1.tags"); i++) {
    total += to_int(json_path(list_json, "items.1.tags." + i));
}
assert_true(total == 6, "loop over a JSON array");

// 10. Building JSON safely
assert_true(json_quote("Лис \"1\"\n") == "\"Лис \\\"1\\\"\\n\"", "json_quote");
assert_true(json_safe("\u0001") == "\\u0001", "control characters are escaped");

// 11. Malformed documents never crash, they simply have no value
assert_true(json_path("{\"a\": ", "a") == "" && json_path("not json", "a") == "" && json_count_at("[1, 2", "") == -1, "malformed input");

print("JSON_ADVANCED_OK");
