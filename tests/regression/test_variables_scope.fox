// FoxLang regression: variables, compound assignments, scope, globals
void assert_true(bool cond, string msg) {
    if (!cond) {
        print("FAIL: " + msg);
        exit(1);
    }
}

// 1. Declarations and reassignments
int v = 10;
v = 20;
assert_true(v == 20, "var reassignment");

// 2. Compound assignments
v += 10;
assert_true(v == 30, "compound +=");
v -= 5;
assert_true(v == 25, "compound -=");
v *= 2;
assert_true(v == 50, "compound *=");
v /= 5;
assert_true(v == 10, "compound /=");

// 3. Post increment
v++;
assert_true(v == 11, "post increment");

// 4. Global variables
global int g_counter = 100;

void modify_global() {
    g_counter += 50;
}

modify_global();
assert_true(g_counter == 150, "global variable modification from function");

// 5. Block scope
int outer = 1;
{
    int inner = 2;
    outer = outer + inner;
}
assert_true(outer == 3, "outer variable modified from inner block");

// 6. A name may shadow an outer one, and each pass of a loop binds its own
global int shadowed = 7;

int read_shadowed() {
    return shadowed;
}

int shadow_locally() {
    int shadowed = 99;
    return read_shadowed() + shadowed;
}

assert_true(shadow_locally() == 106, "local shadows the global for itself only");

int rounds = 0;
int sum = 0;
while (rounds < 4) {
    int per_pass = rounds * 2;
    sum += per_pass;
    rounds++;
}
assert_true(sum == 12, "loop body declares its own variable on every pass");

for (int i = 0; i < 3; i++) {
    int square = i * i;
    sum += square;
}
assert_true(sum == 17, "for body and loop variable stay inside the loop");

print("VARIABLES_SCOPE_OK");
