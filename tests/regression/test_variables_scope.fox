// FoxLang regression: variables, compound assignments, scope, globals
void assert_true(bool cond, string msg) {
    if (!cond) {
        print("FAIL: " + msg);
        exit(1);
    }
}

// 1. Declarations and reassignments
int v = 10;
v = 20;
assert_true(v == 20, "var reassignment");

// 2. Compound assignments
v += 10;
assert_true(v == 30, "compound +=");
v -= 5;
assert_true(v == 25, "compound -=");
v *= 2;
assert_true(v == 50, "compound *=");
v /= 5;
assert_true(v == 10, "compound /=");

// 3. Post increment
v++;
assert_true(v == 11, "post increment");

// 4. Global variables
global int g_counter = 100;

void modify_global() {
    g_counter += 50;
}

modify_global();
assert_true(g_counter == 150, "global variable modification from function");

// 5. Block scope
int outer = 1;
{
    int inner = 2;
    outer = outer + inner;
}
assert_true(outer == 3, "outer variable modified from inner block");

// 6. A name may shadow an outer one, and each pass of a loop binds its own
global int shadowed = 7;

int read_shadowed() {
    return shadowed;
}

int shadow_locally() {
    int shadowed = 99;
    return read_shadowed() + shadowed;
}

assert_true(shadow_locally() == 106, "local shadows the global for itself only");

int rounds = 0;
int sum = 0;
while (rounds < 4) {
    int per_pass = rounds * 2;
    sum += per_pass;
    rounds++;
}
assert_true(sum == 12, "loop body declares its own variable on every pass");

for (int i = 0; i < 3; i++) {
    int square = i * i;
    sum += square;
}
assert_true(sum == 17, "for body and loop variable stay inside the loop");

// Constants: the name cannot change, the contents of a container can
const int LIMIT = 3;
const array SEEN = [1];
push(SEEN, 2);
assert_true(LIMIT == 3 && size(SEEN) == 2, "a constant is read like a variable");
void read_limit_in_lambda() {
    const string word = "fox";
    func read = () => word + LIMIT;
    assert_true(read() == "fox3", "lambdas read constants");
}
read_limit_in_lambda();
string const_error = "";
void change_global(value) { LIMIT = value; }
try { change_global(4); } catch (e) { const_error = e; }
assert_true(str_contains(const_error, "'LIMIT' is a constant"), "a global constant cannot be assigned: " + const_error);
const_error = "";
void bump_global(value) { LIMIT++; }
try { bump_global(1); } catch (e) { const_error = e; }
assert_true(str_contains(const_error, "'LIMIT' is a constant"), "nor incremented: " + const_error);
assert_true(LIMIT == 3, "the constant kept its value");

print("VARIABLES_SCOPE_OK");
