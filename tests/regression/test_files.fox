// FoxLang regression: file operations (write, append, read)
void assert_true(bool cond, string msg) {
    if (!cond) {
        print("FAIL: " + msg);
        exit(1);
    }
}

string test_filename = "temp_test_file.txt";

// 1. Write file
bool w_ok = write_file(test_filename, "First line\n");
assert_true(w_ok == true, "write_file success");

// 2. Read file
string content1 = read_file(test_filename);
assert_true(content1 == "First line\n", "read_file content");

// 3. Append to file
bool a_ok = append_file(test_filename, "Second line\n");
assert_true(a_ok == true, "append_file success");

string content2 = read_file(test_filename);
assert_true(content2 == "First line\nSecond line\n", "read_file after append");

// 4. Overwrite file
write_file(test_filename, "Overwritten");
string content3 = read_file(test_filename);
assert_true(content3 == "Overwritten", "read_file returns the file byte for byte");

// 5. Read non-existent file returns empty string
string missing = read_file("non_existent_file_definitely_not_here.txt");
assert_true(missing == "", "missing file returns empty string");

// 6. Text without a trailing newline and Windows line ends are kept as written
write_file(test_filename, "a\r\nб\r\n🦊");
assert_true(read_file(test_filename) == "a\r\nб\r\n🦊", "read_file keeps CRLF and the missing final newline");

// 7. fs module: existence, sizes, directories, listing, lines
using fs;
assert_true(exists(test_filename), "exists for a file");
assert_true(!is_dir(test_filename), "a file is not a directory");
assert_true(file_size(test_filename) == 11, "file_size counts bytes");
assert_true(file_size("non_existent_file_definitely_not_here.txt") == -1, "file_size of a missing file");

string dir = "temp_fs_test_dir/nested";
assert_true(make_dir(dir), "make_dir creates parents");
assert_true(is_dir(dir), "is_dir after make_dir");
write_file(dir + "/b.txt", "B");
write_file(dir + "/a.txt", "A");
array names = list_dir(dir);
assert_true(size(names) == 2 && names[0] == "a.txt" && names[1] == "b.txt", "list_dir is sorted");
assert_true(size(list_dir("no_such_directory_here")) == 0, "list_dir of a missing directory");

array lines = ["первая", "вторая", ""];
assert_true(write_lines(dir + "/lines.txt", lines), "write_lines");
assert_true(read_file(dir + "/lines.txt") == "первая\nвторая\n\n", "write_lines content");
array back = read_lines(dir + "/lines.txt");
assert_true(size(back) == 3 && back[1] == "вторая" && back[2] == "", "read_lines round trip");

// remove_path deletes files and only empty directories
assert_true(!remove_path("temp_fs_test_dir"), "remove_path refuses a non-empty directory");
assert_true(remove_path(dir + "/a.txt") && remove_path(dir + "/b.txt") && remove_path(dir + "/lines.txt"), "remove files");
assert_true(remove_path(dir) && remove_path("temp_fs_test_dir"), "remove empty directories");
assert_true(!exists("temp_fs_test_dir"), "directory is gone");
assert_true(remove_path(test_filename) && !exists(test_filename), "remove the test file");

// 8. Details, copying, moving and trees
using os;
using time;
using string;
string base = join_path(temp_dir(), "foxlang files test");
remove_tree(base);
assert_true(make_dir(join_path(base, "src/deep")), "nested directories");
string script = join_path(base, "src/deep/run.sh");
write_file(script, "#!/bin/sh\necho hi\n");
assert_true(is_file(script) && !is_dir(script) && !is_link(script), "is_file");
assert_true(file_size(script) == 18 && type_of(file_size(script)) == "float", "file_size is a float");
assert_true(modified_ms(script) > unix_time_ms() - 600000 && modified_ms(join_path(base, "missing")) == -1, "modified_ms");
if (platform() != "windows") {
    assert_true(set_permissions(script, "754") && permissions(script) == "rwxr-xr--", "octal permissions");
    assert_true(is_executable(script), "is_executable after chmod");
    assert_true(set_permissions(script, "rw-r-----") && permissions(script) == "rw-r-----" && !is_executable(script), "symbolic permissions");
    assert_true(owner(script) != "", "owner");
}
assert_true(permissions(join_path(base, "missing")) == "", "permissions of a missing path");

assert_true(copy_path(join_path(base, "src"), join_path(base, "copy")), "copy a tree");
assert_true(read_file(join_path(base, "copy/deep/run.sh")) == "#!/bin/sh\necho hi\n", "copied content");
assert_true(!copy_path(join_path(base, "src"), join_path(base, "copy")), "copy refuses to overwrite");
assert_true(fs_copy(join_path(base, "src"), join_path(base, "copy"), true), "copy with overwrite");
assert_true(move_path(join_path(base, "copy"), join_path(base, "moved")), "move a tree");
assert_true(!exists(join_path(base, "copy")) && exists(join_path(base, "moved/deep/run.sh")), "moved");
assert_true(!move_path(join_path(base, "src"), join_path(base, "moved")), "move refuses an existing target");
assert_true(remove_tree(join_path(base, "moved")) == 3 && !exists(join_path(base, "moved")), "remove_tree counts entries");
assert_true(remove_tree(join_path(base, "moved")) == 0, "remove_tree of a missing path");
assert_true(free_space(base) > 0 && home_dir() != "", "free space and home");

// 9. Paths
assert_true(file_name(join_path("dir", "notes.txt")) == "notes.txt" && file_name("dir/sub/") == "sub", "file_name");
assert_true(file_stem("archive.tar.gz") == "archive.tar" && file_extension("archive.tar.gz") == ".gz", "stem and extension");
assert_true(file_extension(".env") == "" && file_extension("README") == "", "no extension");
assert_true(parent_dir(join_path(join_path("a", "b"), "c.txt")) == join_path("a", "b"), "parent_dir");
assert_true(format_bytes(532) == "532 B" && format_bytes(1536) == "1.5 KB" && format_bytes(3435973837.0) == "3.2 GB", "format_bytes");
assert_true(absolute_path("x") == join_path(cwd(), "x"), "absolute_path");

// 10. Running programs without a shell
string greeting = "";
if (platform() == "windows") {
    greeting = run_output("cmd", ["/c", "echo", "hi"]);
} else {
    greeting = run_output("sh", ["-c", "echo \"$1 $2\"", "sh", "привет", "a b"]);
}
assert_true(last_exit() == 0 && trim(greeting) != "", "run_output");
if (platform() != "windows") {
    assert_true(trim(greeting) == "привет a b", "arguments reach the program unchanged");
    assert_true(run("sh", ["-c", "exit 7"]) == 7, "exit code");
}
assert_true(run("definitely-not-a-program-foxlang", []) == -1, "missing program");
assert_true(remove_tree(base) > 0, "cleanup");

print("FILES_OK");
