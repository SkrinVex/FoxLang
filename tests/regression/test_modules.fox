// FoxLang regression: include, using, relative imports, duplicate loading
void assert_true(bool cond, string msg) {
    if (!cond) {
        print("FAIL: " + msg);
        exit(1);
    }
}

// 1. Relative include
include("helper_module.fox");
assert_true(helper_add(10, 20) == 30, "function from included module");
assert_true(helper_load_count == 1, "module loaded once");

// Mutate global value; if re-imported, it would be reset back to 1
helper_load_count = 99;

// 2. Duplicate include should be ignored
include("helper_module.fox");
assert_true(helper_load_count == 99, "duplicate include does not re-execute module");

// 3. Using standard library module: functions and module variables
using math;
assert_true(clamp01(1.5) == 1.0, "math module function");
assert_true(PI > 3.14159 && PI < 3.1416, "math module constant");

// 4. A repeated using loads the module once
using fs;
using fs;
assert_true(is_dir("."), "fs module function");
assert_true(size(read_lines("definitely_missing_file.txt")) == 0, "fs module helper written in FoxLang");

// 5. A module alias: functions and variables through the dot
using arrays as arr;
using math as m;
assert_true(m.hypot(3, 4) == 5.0, "a module function through an alias");
assert_true(m.PI == PI, "a module variable through an alias");
assert_true(arr.sum([1, 2, 3]) == 6.0 && arr.transform([1], x => x + 1) == [2], "a second alias");
assert_true(arr.reduce([1, 2], (a, b) => a + b, 0) == 3, "a func variable of the module");
assert_true(type_of(m) == "map", "an alias is a map");
float read_alias() { return m.lerp(0, 10, 0.5); }
assert_true(read_alias() == 5.0, "an alias inside a function");
string message = "";
try { arr.nope(); } catch (e) { message = e; }
assert_true(str_contains(message, "no key 'nope'"), "a missing name through an alias: " + message);

print("MODULES_OK");
