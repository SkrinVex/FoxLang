// FoxLang regression: stdlib modules
using math;
using string;
using time;
using log;
using env;
using json;
using terminal;

void assert_true(bool cond, string msg) {
    if (!cond) {
        print("FAIL: " + msg);
        string f = env_required("__ASSERT_FAIL__");
    }
}

// 1. Math stdlib
assert_true(min_int(3, 9) == 3, "min_int");
assert_true(max_int(3, 9) == 9, "max_int");
assert_true(clamp01(1.5) == 1, "clamp01 high");
assert_true(clamp01(-0.5) == 0, "clamp01 low");
assert_true(sqrt(9.0) == 3.0, "sqrt");
assert_true(pow(2.0, 10.0) == 1024.0, "pow");
assert_true(floor(-2.5) == -3.0, "floor rounds down, not toward zero");
assert_true(ceil(2.1) == 3.0, "ceil");
assert_true(sin(0.0) == 0.0, "sin of zero");
assert_true(cos(0.0) == 1.0, "cos of zero");
assert_true(hypot(3.0, 4.0) == 5.0, "hypot");
float half_turn = radians(180.0);
assert_true(half_turn > 3.1415 && half_turn < 3.1416, "radians of half turn");

// 2. String stdlib
assert_true(contains("FoxLang Programming", "Lang"), "contains true");
assert_true(!contains("FoxLang Programming", "Python"), "contains false");
assert_true(replace("hello world", "world", "fox") == "hello fox", "replace");
assert_true(to_int("12345") == 12345, "to_int");
assert_true(strtoint("12345") == 12345, "strtoint");
assert_true(str_length("Лисий отскок") == 12, "str_length counts characters");
assert_true(size("Лисий отскок") == 23, "size counts UTF-8 bytes");
assert_true(length("Привет") == 6, "length wrapper counts characters");

// 3. Time stdlib
string t1 = unix_time_ms();
sleep_ms(10);
string t2 = unix_time_ms();
assert_true(size(t1) > 0 && size(t2) > 0, "unix_time_ms returns non-empty timestamps");

// 4. Log stdlib
debug("debug message");
info("info message");
warn("warn message");
error("error message");

// 5. JSON stdlib
string safe_str = json_safe("Line1\nLine2 \"quoted\"");
assert_true(contains(safe_str, "\\n"), "json_safe newline");
assert_true(contains(safe_str, "\\\""), "json_safe quote");

// 6. Terminal stdlib (basic smoke test)
reset_color();

print("STDLIB_OK");
