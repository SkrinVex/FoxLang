// FoxLang regression: maps, structs, nested containers, try/catch/finally/throw
void check(bool cond, string msg) {
    if (!cond) {
        print("FAIL: " + msg);
        exit(1);
    }
}

// --- Maps
map ages = {"Ann": 30, Bob: 25};
check(size(ages) == 2, "map literal size");
check(ages["Ann"] == 30 && ages.Bob == 25, "map read by index and by field");
ages["Cid"] = 41;
ages.Ann += 1;
check(ages["Ann"] == 31 && size(ages) == 3, "map write and compound assignment");
check(has(ages, "Cid") && !has(ages, "Dan"), "has");
check(str_join(keys(ages), ",") == "Ann,Bob,Cid", "keys keep insertion order");
check(get_or(ages, "Dan", -1) == -1 && get_or(ages, "Bob", -1) == 25, "get_or on a map");
check(remove_key(ages, "Bob") && !remove_key(ages, "Bob") && size(ages) == 2, "remove_key");
map empty;
check(size(empty) == 0 && type_of(empty) == "map", "declared empty map");
map numbered = {};
numbered[7] = "seven";
check(numbered["7"] == "seven", "int keys are text");

// --- Sharing on assignment and with functions; copy() makes an independent copy
map original = {"list": [1, 2]};
map alias = original;
alias["list"][0] = 100;
check(original["list"][0] == 100, "assignment shares the map");
map separate = copy(original);
separate["list"][0] = 5;
check(original["list"][0] == 100 && separate["list"][0] == 5, "copy() copies nested containers");
original["list"][0] = 1;
void grow(map target) { target["added"] = true; }
grow(original);
check(has(original, "added") && has(alias, "added"), "a function changes the map it was given");
check(original != separate && separate == separate, "maps compare by contents");
map twin = {"list": [1, 2], "added": true};
check(original == twin, "equal contents are equal");

// --- Structs
struct Point {
    int x;
    int y = 5;
}
struct User {
    string name;
    int age;
    array tags;
    Point home;
    map extra;
}
Point p = Point(1);
check(p.x == 1 && p.y == 5, "defaults fill trailing fields");
Point origin;
check(origin.x == 0 && origin.y == 5 && type_of(origin) == "Point", "declared struct starts with defaults");
User u = User("Ann", 30, ["admin"]);
u.age += 1;
u.home.x = 10;
push(u.tags, "dev");
u.extra["team"] = "core";
check(u.age == 31 && u.home.x == 10 && size(u.tags) == 2 && u.extra.team == "core", "nested fields");
check("" + p == "Point{x: 1, y: 5}", "struct text");
User shared = u;
shared.age = 40;
check(u.age == 40, "struct assignment shares");
u.age = 31;
User v = copy(u);
v.name = "Bob";
check(u.name == "Ann", "copy() of a struct is independent");
array users = [u, v];
users[1].tags[0] = "guest";
check(v.tags[0] == "guest" && u.tags[0] == "admin", "an array holds the structs themselves");
User birthday(User who) {
    who.age += 1;
    return who;
}
User older = birthday(u);
check(older.age == 32 && u.age == 32, "struct parameters are shared");
older.age = 50;
check(u.age == 50, "the returned struct is the same struct");

bool typed = false;
try {
    u.age = "old";
} catch (string e) {
    typed = str_contains(e, "age");
}
check(typed, "a field keeps its declared type");

// --- Nested arrays
array grid = [[1, 2], [3, 4]];
grid[1][0] = 30;
check(grid[1][0] == 30 && size(grid[0]) == 2, "nested array write");
array row = grid[0];
row[0] = 99;
check(grid[0][0] == 99, "an element is the nested array itself");
array loop = [1];
push(loop, loop);
check("" + loop == "[1, [...]]" && loop == loop && size(copy(loop)[1]) == 2, "a container inside itself");
check([1, [2, 3]] == [1, [2, 3]] && [1] != [2], "arrays compare by contents");

// --- JSON
map doc = json_decode("{\"name\": \"Лис\", \"tags\": [1, 2.5, true], \"inner\": {\"ok\": null}}");
check(doc.name == "Лис" && doc["tags"][0] == 1 && type_of(doc["tags"][1]) == "float", "json_decode");
check(doc.inner.ok == "", "null becomes empty text");
check(json_value(Point(3, 4)) == "{\"x\":3,\"y\":4}", "struct to JSON");
check(json_value({"a": [1, "b"]}) == "{\"a\":[1,\"b\"]}", "map to JSON");

// --- try / catch / finally / throw
string log = "";
try {
    log += "a";
    int zero = 0;
    int boom = 10 / zero;
    log += "never";
} catch (string e) {
    log += "b";
    check(str_contains(e, "Division by zero"), "caught message");
} finally {
    log += "c";
}
check(log == "abc", "try, catch and finally run in order");

void risky(int n) {
    if (n > 2) {
        throw "слишком много: " + n;
    }
}
string caught = "";
try {
    risky(5);
} catch (message) {
    caught = message;
}
check(caught == "слишком много: 5", "throw from a function");

int cleaned = 0;
int early() {
    try {
        return 1;
    } finally {
        cleaned++;
    }
    return 2;
}
check(early() == 1 && cleaned == 1, "finally runs on return");

int loops = 0;
for (int i = 0; i < 3; i++) {
    try {
        if (i == 1) {
            continue;
        }
        loops++;
    } finally {
        loops += 10;
    }
}
check(loops == 32, "finally runs on continue");

string rethrown = "";
try {
    try {
        throw "inner";
    } catch (e) {
        throw e + "+outer";
    }
} catch (e) {
    rethrown = e;
}
check(rethrown == "inner+outer", "rethrow from catch");

bool missingKey = false;
try {
    int x = ages["nobody"];
} catch (e) {
    missingKey = str_contains(e, "nobody");
}
check(missingKey, "missing key is an error that can be caught");

print("STRUCTURES_OK");
