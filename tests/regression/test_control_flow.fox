// FoxLang regression: if/else, while, for, switch, break, continue
void assert_true(bool cond, string msg) {
    if (!cond) {
        print("FAIL: " + msg);
        exit(1);
    }
}

// 1. If / else
int branch = 0;
if (false) {
    branch = 1;
} else if (true) {
    branch = 2;
} else {
    branch = 3;
}
assert_true(branch == 2, "if else-if else");

// 2. While loop with break and continue
int w = 0;
int w_sum = 0;
while (w < 10) {
    w++;
    if (w == 3) { continue; }
    if (w == 6) { break; }
    w_sum += w;
}
// w: 1 (sum=1), 2 (sum=3), 3 (continue), 4 (sum=7), 5 (sum=12), 6 (break)
assert_true(w_sum == 12, "while break and continue");

// 3. For loop with step and break
int f_sum = 0;
for (int i = 0; i < 10; i++) {
    if (i == 1) { continue; }
    if (i == 4) { break; }
    f_sum += i;
}
// i: 0 (sum=0), 1 (continue), 2 (sum=2), 3 (sum=5), 4 (break)
assert_true(f_sum == 5, "for loop sum");

// 4. Switch / case / default
int switch_val = 2;
int switch_res = 0;
switch (switch_val) {
    case 1:
        switch_res = 10;
        break;
    case 2:
        switch_res = 20;
        break;
    case 3:
        switch_res = 30;
        break;
    default:
        switch_res = -1;
}
assert_true(switch_res == 20, "switch matching case");

switch_val = 99;
switch_res = 0;
switch (switch_val) {
    case 1:
        switch_res = 10;
        break;
    default:
        switch_res = 999;
}
assert_true(switch_res == 999, "switch default case");

// 5. Fall-through: without break the next branches run, default included
string trail = "";
switch (2) {
    case 1:
        trail += "1";
    case 2:
        trail += "2";
    case 3:
        trail += "3";
    default:
        trail += "d";
}
assert_true(trail == "23d", "switch falls through into later branches");

// 6. Switch on strings; 1 and 1.0 are the same case
string kind = "";
switch ("лис") {
    case "волк":
        kind = "wolf";
        break;
    case "лис":
        kind = "fox";
        break;
}
assert_true(kind == "fox", "switch on strings");
switch (1.0) {
    case 1:
        kind = "one";
        break;
}
assert_true(kind == "one", "numeric cases compare by value");

// 7. for with an empty condition, a compound condition and any step statement
int spins = 0;
for (;;) {
    spins++;
    if (spins == 3) { break; }
}
assert_true(spins == 3, "for (;;) loops until break");
int pairs = 0;
for (int i = 0; i < 10 && pairs < 3; i += 2) {
    pairs++;
}
assert_true(pairs == 3, "for condition with &&");
int down = 0;
for (int i = 5; i > 0; i--) {
    down += i;
}
assert_true(down == 15, "for with i--");

// 8. continue inside switch continues the loop
int odd = 0;
for (int i = 0; i < 6; i++) {
    switch (i % 2) {
        case 0:
            continue;
    }
    odd++;
}
assert_true(odd == 3, "continue inside switch");

// 9. for-in over arrays, maps and strings
array values = [3, 4, 5];
int each = 0;
for (v in values) {
    each += v;
}
assert_true(each == 12, "for-in over an array");
string pairs_seen = "";
for (i, v in values) {
    pairs_seen += "${i}:${v} ";
}
assert_true(pairs_seen == "0:3 1:4 2:5 ", "for-in with index and element");
map scores = {"a": 1, "b": 2};
string keys_seen = "";
int score_sum = 0;
for (string key, int score in scores) {
    keys_seen += key;
    score_sum += score;
}
assert_true(keys_seen == "ab" && score_sum == 3, "for-in over a map");
string letters = "";
int count = 0;
for (n, ch in "Лис") {
    letters = ch + letters;
    count = n + 1;
}
assert_true(letters == "сиЛ" && count == 3, "for-in over characters");
int stopped = 0;
for (v in [1, 2, 3, 4]) {
    if (v == 2) {
        continue;
    }
    if (v == 4) {
        break;
    }
    stopped += v;
}
assert_true(stopped == 4, "break and continue in for-in");
array grown = [1];
int rounds = 0;
for (v in grown) {
    if (size(grown) < 3) {
        push(grown, v + 1);
    }
    rounds++;
}
assert_true(rounds == 3, "for-in sees elements added during the loop");
int in = 7;
assert_true(in == 7, "in is still a name");

print("CONTROL_FLOW_OK");
