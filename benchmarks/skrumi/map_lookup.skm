// Inserting keys into a map and looking every one of them up.
using os;

int n = to_int(arg_or(0, "200000"));
map index = {};
for (int i = 0; i < n; i++) {
    index["k" + i] = i;
}
int total = 0;
for (int i = 0; i < n; i++) {
    total = total + index["k" + i] % 1000;
}
print(total, size(index));
