//! Переменные окружения и секреты. При запуске исходника FoxLang сначала читает `.env`
//! рядом со скриптом (standalone-программы `.env` не читают).

/// Значение переменной окружения или пустая строка, если она не задана.
string env(string name) { return env_get(name); }

/// Обязательный секрет: если переменная не задана или пуста, программа завершается с ошибкой.
///
/// ```foxlang
/// string token = secret("TELEGRAM_BOT_TOKEN");
/// ```
string secret(string name) { return env_required(name); }

/// Значение переменной окружения или `fallback`, если она не задана или пуста.
///
/// ```foxlang
/// int port = to_int(env_default("PORT", "8080"));
/// ```
string env_default(string name, string fallback) {
    string value = env_get(name);
    if (value == "") {
        return fallback;
    }
    return value;
}

/// Задаёт переменную окружения текущего процесса. `true` при успехе.
bool set_env(string name, string value) { return env_set(name, value); }
