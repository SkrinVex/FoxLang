// Переменные окружения и секреты. FoxLang автоматически читает .env.
string env(string name) { return env_get(name); }
string secret(string name) { return env_required(name); }

string env_default(string name, string fallback) {
    string val = env_get(name);
    if (val == "") {
        return fallback;
    }
    return val;
}
