//! HTTP(S)-клиент. Функции возвращают тело ответа при любом коде статуса;
//! код последнего запроса возвращает `http_status()`, `0` означает, что ответа не было.

/// GET-запрос; возвращает тело ответа.
///
/// ```foxlang
/// string page = http_get("https://example.com");
/// if (http_status() != 200) { warn("HTTP " + http_status()); }
/// ```
string http_get(string url) { return http_request("GET", url, "", ""); }

/// DELETE-запрос; возвращает тело ответа.
string http_delete(string url) { return http_request("DELETE", url, "", ""); }

/// POST-запрос с телом и типом содержимого.
string http_post(string url, string body, string content_type) {
    return http_request("POST", url, body, content_type);
}

/// PUT-запрос с телом и типом содержимого.
string http_put(string url, string body, string content_type) {
    return http_request("PUT", url, body, content_type);
}

/// PATCH-запрос с телом и типом содержимого.
string http_patch(string url, string body, string content_type) {
    return http_request("PATCH", url, body, content_type);
}

/// POST-запрос с `Content-Type: application/json`.
string http_post_json(string url, string body) {
    return http_request("POST", url, body, "application/json");
}

/// PUT-запрос с `Content-Type: application/json`.
string http_put_json(string url, string body) {
    return http_request("PUT", url, body, "application/json");
}

/// Был ли последний запрос успешным: статус от 200 до 299.
bool http_ok() {
    int status = http_status();
    return status >= 200 && status < 300;
}
