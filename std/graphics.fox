//! Нативная 2D-графика Linux/Windows: окно, фигуры, текст, клавиатура и мышь.
//! Подробности — в docs/GRAPHICS.md.

void open_window(int width, int height, string title) { gfx_open(width, height, title); }
bool window_poll() { return gfx_poll(); }
void close_window() { gfx_close(); }
void clear_window(int color) { gfx_clear(color); }
void draw_rect(int x, int y, int width, int height, int color) { gfx_rect(x, y, width, height, color); }
void draw_circle(int x, int y, int radius, int color) { gfx_circle(x, y, radius, color); }
void draw_text(int x, int y, string text, int scale, int color) { gfx_text(x, y, text, scale, color); }
void draw_line(int x1, int y1, int x2, int y2, int color) { gfx_line(x1, y1, x2, y2, color); }
void draw_frame(int x, int y, int width, int height, int thickness, int color) { gfx_frame(x, y, width, height, thickness, color); }
void draw_ring(int x, int y, int radius, int thickness, int color) { gfx_ring(x, y, radius, thickness, color); }
int text_width(string text, int scale) { return gfx_text_width(text, scale); }
void present_window() { gfx_present(); }
float frame_delta() { return gfx_delta(); }
bool key_down(string key) { return gfx_down(key); }
bool key_pressed(string key) { return gfx_pressed(key); }
int mouse_x() { return gfx_mouse_x(); }
int mouse_y() { return gfx_mouse_y(); }
bool window_focused() { return gfx_focused(); }
int rgb(int red, int green, int blue) { return gfx_rgb(red, green, blue); }
bool key_repeat(string key) { return gfx_repeat(key); }
string text_input() { return gfx_text_input(); }
int mouse_wheel() { return gfx_wheel(); }
bool double_clicked() { return gfx_double_click(); }
string clipboard_text() { return gfx_clipboard(); }
void set_clipboard_text(string text) { gfx_set_clipboard(text); }
void draw_rect_alpha(int x, int y, int width, int height, int color, int alpha) { gfx_rect_alpha(x, y, width, height, color, alpha); }
int window_width() { return gfx_width(); }
int window_height() { return gfx_height(); }
void clip_begin(int x, int y, int width, int height) { gfx_clip_begin(x, y, width, height); }
void clip_end() { gfx_clip_end(); }
