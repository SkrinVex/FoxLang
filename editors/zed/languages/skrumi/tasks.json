[
  {
    "label": "Skrumi: запустить $ZED_FILENAME",
    "command": "skrumi",
    "args": ["$ZED_FILE"],
    "cwd": "$ZED_DIRNAME",
    "tags": ["skrumi-run"]
  },
  {
    "label": "Skrumi: проверить $ZED_FILENAME",
    "command": "skrumi",
    "args": ["check", "$ZED_FILE"],
    "cwd": "$ZED_DIRNAME"
  },
  {
    "label": "Skrumi: собрать $ZED_STEM",
    "command": "skrumi",
    "args": ["build", "$ZED_FILE", "-o", "$ZED_STEM"],
    "cwd": "$ZED_DIRNAME"
  }
]
