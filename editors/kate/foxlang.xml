<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE language SYSTEM "language.dtd">
<language name="FoxLang" version="3" kateversion="5.0" section="Sources"
          extensions="*.fox" mimetype="text/x-foxlang" author="SkrinVex" license="MIT">
  <highlighting>
    <list name="controlflow">
      <item>if</item>
      <item>else</item>
      <item>while</item>
      <item>for</item>
      <item>switch</item>
      <item>case</item>
      <item>default</item>
      <item>break</item>
      <item>continue</item>
      <item>return</item>
      <item>wait</item>
    </list>
    <list name="directives">
      <item>using</item>
      <item>include</item>
    </list>
    <list name="modifiers">
      <item>global</item>
      <item>const</item>
    </list>
    <list name="types">
      <item>int</item>
      <item>float</item>
      <item>string</item>
      <item>bool</item>
      <item>void</item>
      <item>array</item>
    </list>
    <list name="constants">
      <item>true</item>
      <item>false</item>
    </list>
    <list name="builtins">
      <item>print</item>
      <item>fox</item>
      <item>input</item>
      <item>getch</item>
      <item>kbhit</item>
      <item>round</item>
      <item>random</item>
      <item>abs</item>
      <item>min</item>
      <item>max</item>
      <item>sqrt</item>
      <item>pow</item>
      <item>floor</item>
      <item>ceil</item>
      <item>str_to_int</item>
      <item>str_contains</item>
      <item>size</item>
      <item>set</item>
      <item>get</item>
      <item>length</item>
      <item>substring</item>
      <item>trim</item>
      <item>split</item>
      <item>replace</item>
      <item>read_file</item>
      <item>readfile</item>
      <item>write_file</item>
      <item>append_file</item>
      <item>file_exists</item>
      <item>json_get</item>
      <item>json_path</item>
      <item>json_safe</item>
      <item>json_parse</item>
      <item>json_stringify</item>
      <item>secret</item>
      <item>env_get</item>
      <item>env_set</item>
      <item>get_env</item>
      <item>load_env</item>
      <item>server_start</item>
      <item>server_stop</item>
      <item>route_get</item>
      <item>route_post</item>
      <item>send_response</item>
      <item>request_body</item>
      <item>request_method</item>
      <item>request_path</item>
      <item>respond</item>
      <item>respond_status</item>
      <item>listen</item>
      <item>body</item>
      <item>method</item>
      <item>path</item>
      <item>http_get</item>
      <item>http_post</item>
      <item>http_put</item>
      <item>http_delete</item>
      <item>http_post_json</item>
      <item>httpget</item>
      <item>httppost</item>
      <item>httpput</item>
      <item>httpdelete</item>
      <item>log_debug</item>
      <item>log_info</item>
      <item>log_warn</item>
      <item>log_error</item>
      <item>debug</item>
      <item>info</item>
      <item>warn</item>
      <item>error</item>
      <item>sleep</item>
    </list>

    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <DetectSpaces/>
        <Detect2Chars char="/" char1="/" attribute="Comment" context="LineComment"/>
        <Detect2Chars char="/" char1="*" attribute="Comment" context="BlockComment" beginRegion="CommentRegion"/>
        
        <keyword attribute="Control Flow" context="#stay" String="controlflow"/>
        <keyword attribute="Directive" context="#stay" String="directives"/>
        <keyword attribute="Storage Modifier" context="#stay" String="modifiers"/>
        <keyword attribute="Data Type" context="#stay" String="types"/>
        <keyword attribute="Constant" context="#stay" String="constants"/>
        <keyword attribute="Builtin" context="#stay" String="builtins"/>
        
        <DetectChar char="&quot;" attribute="String" context="String"/>
        
        <!-- Numbers -->
        <HlCHex attribute="Hex" context="#stay"/>
        <Float attribute="Float" context="#stay"/>
        <Int attribute="Decimal" context="#stay"/>
        
        <!-- Block folding -->
        <DetectChar char="{" attribute="Symbol" context="#stay" beginRegion="BraceBlock"/>
        <DetectChar char="}" attribute="Symbol" context="#stay" endRegion="BraceBlock"/>
        
        <!-- Operators and Delimiters -->
        <AnyChar String="+-*/%=!&lt;&gt;&amp;|^~" attribute="Operator" context="#stay"/>
        <AnyChar String="();,[]" attribute="Symbol" context="#stay"/>
      </context>

      <context name="LineComment" attribute="Comment" lineEndContext="#pop">
        <DetectSpaces/>
        <StringDetect String="TODO" attribute="Alert" context="#stay"/>
        <StringDetect String="FIXME" attribute="Alert" context="#stay"/>
        <StringDetect String="NOTE" attribute="Alert" context="#stay"/>
        <StringDetect String="WARN" attribute="Alert" context="#stay"/>
      </context>

      <context name="BlockComment" attribute="Comment" lineEndContext="#stay">
        <DetectSpaces/>
        <Detect2Chars char="*" char1="/" attribute="Comment" context="#pop" endRegion="CommentRegion"/>
        <StringDetect String="TODO" attribute="Alert" context="#stay"/>
        <StringDetect String="FIXME" attribute="Alert" context="#stay"/>
        <StringDetect String="NOTE" attribute="Alert" context="#stay"/>
        <StringDetect String="WARN" attribute="Alert" context="#stay"/>
      </context>

      <context name="String" attribute="String" lineEndContext="#stay">
        <DetectChar char="&quot;" attribute="String" context="#pop"/>
        <DetectChar char="\" attribute="Char" context="StringEscape"/>
      </context>

      <context name="StringEscape" attribute="Char" lineEndContext="#pop">
        <Detect2Chars char="\" char1="u" attribute="Char" context="UnicodeEscape"/>
        <AnyChar String="&quot;\/bfnrt" attribute="Char" context="#pop"/>
      </context>

      <context name="UnicodeEscape" attribute="Char" lineEndContext="#pop" fallthrough="true" fallthroughContext="#pop">
        <RegExpr String="[0-9a-fA-F]{4}" attribute="Char" context="#pop#pop"/>
      </context>
    </contexts>

    <itemDatas>
      <itemData name="Normal Text" defStyleNum="dsNormal"/>
      <itemData name="Control Flow" defStyleNum="dsControlFlow"/>
      <itemData name="Directive" defStyleNum="dsPreprocessor"/>
      <itemData name="Storage Modifier" defStyleNum="dsAttribute"/>
      <itemData name="Data Type" defStyleNum="dsDataType"/>
      <itemData name="Constant" defStyleNum="dsConstant"/>
      <itemData name="Builtin" defStyleNum="dsFunction"/>
      <itemData name="Decimal" defStyleNum="dsDecVal"/>
      <itemData name="Hex" defStyleNum="dsBaseN"/>
      <itemData name="Float" defStyleNum="dsFloat"/>
      <itemData name="String" defStyleNum="dsString"/>
      <itemData name="Char" defStyleNum="dsSpecialChar"/>
      <itemData name="Comment" defStyleNum="dsComment"/>
      <itemData name="Alert" defStyleNum="dsAlert"/>
      <itemData name="Operator" defStyleNum="dsOperator"/>
      <itemData name="Symbol" defStyleNum="dsNormal"/>
    </itemDatas>
  </highlighting>
  <general>
    <comments>
      <comment name="singleLine" value="//"/>
      <comment name="multiLine" start="/*" end="*/"/>
    </comments>
    <keywords casesensitive="1"/>
  </general>
</language>
