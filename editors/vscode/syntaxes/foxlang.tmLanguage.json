{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FoxLang",
  "scopeName": "source.fox",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#builtins" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.fox",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.fox",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.fox",
          "match": "\\\\([\"\\\\/bfnrt]|u[0-9a-fA-F]{4})"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.fox",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.fox",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.fox",
          "match": "\\b(if|else|while|for|switch|case|default|break|continue|return)\\b"
        },
        {
          "name": "keyword.other.module.fox",
          "match": "\\b(using|include|global)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.fox",
          "match": "\\b(int|float|string|bool|void|array)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.fox",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(int|float|string|bool|void)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "storage.type.primitive.fox" },
            "2": { "name": "entity.name.function.fox" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.fox" }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.fox",
          "match": "\\b(print|fox|input|round|random|read_file|readfile|json_get|json_path|json_safe|str_contains|str_to_int|size|set|get|server_start|server_stop|route_get|route_post|send_response|request_body|request_method|request_path|respond|respond_status|listen|body|method|path|http_get|http_post|http_put|http_delete|http_post_json|httpget|httppost|httpput|httpdelete|getch|kbhit|log_debug|log_info|log_warn|log_error|env_get|env_set)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.fox",
          "match": "(\\+\\+|\\+=|-=|\\*=|/=|==|!=|<=|>=|&&|\\|\\||\\+|-|\\*|/|%|!|=|<|>)"
        }
      ]
    }
  }
}
