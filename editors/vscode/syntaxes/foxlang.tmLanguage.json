{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FoxLang",
  "scopeName": "source.fox",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#modules" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#function-definitions" },
    { "include": "#builtins" },
    { "include": "#function-calls" },
    { "include": "#variable-declarations" },
    { "include": "#operators" },
    { "include": "#delimiters" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.fox",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "name": "keyword.codetag.notation.fox",
              "match": "\\b(TODO|FIXME|NOTE|WARN|WARNING|BUG|XXX)\\b:?"
            },
            {
              "name": "storage.type.class.javadoc.fox",
              "match": "@(param|return|throws|brief|deprecated)\\b"
            }
          ]
        },
        {
          "name": "comment.line.double-slash.fox",
          "begin": "//",
          "end": "$",
          "patterns": [
            {
              "name": "keyword.codetag.notation.fox",
              "match": "\\b(TODO|FIXME|NOTE|WARN|WARNING|BUG|XXX)\\b:?"
            }
          ]
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.fox",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.unicode.fox",
          "match": "\\\\u[0-9a-fA-F]{4}"
        },
        {
          "name": "constant.character.escape.fox",
          "match": "\\\\[\"\\\\/bfnrt]"
        },
        {
          "name": "invalid.illegal.unknown-escape.fox",
          "match": "\\\\[^\"\\\\/bfnrtu]"
        },
        {
          "name": "markup.underline.link.fox",
          "match": "https?://[a-zA-Z0-9\\-._~:/?#\\[\\]@!$&'()*+,;%=]+"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.fox",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.fox",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.fox",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "modules": {
      "patterns": [
        {
          "match": "\\b(using|include)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.directive.fox" },
            "2": { "name": "entity.name.namespace.fox" }
          }
        },
        {
          "match": "\\b(global)\\b",
          "name": "storage.modifier.fox"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.fox",
          "match": "\\b(if|else|while|for|switch|case|default|break|continue|return|wait)\\b"
        },
        {
          "name": "keyword.other.module.fox",
          "match": "\\b(using|include)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.fox",
          "match": "\\b(int|float|string|bool|void|array)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.fox",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "function-definitions": {
      "patterns": [
        {
          "match": "\\b(int|float|string|bool|void)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "storage.type.primitive.fox" },
            "2": { "name": "entity.name.function.definition.fox" }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.fox",
          "match": "\\b(abs|append_file|body|ceil|clamp|clamp01|clear|clear_window|close_tcp|close_window|color|connect_tcp|contains|cos|debug|dns_lookup|draw_circle|draw_rect|draw_text|env|env_default|env_get|env_required|error|floor|fox|frame_delta|get|getch|gfx_circle|gfx_clear|gfx_close|gfx_delta|gfx_down|gfx_focused|gfx_mouse_x|gfx_mouse_y|gfx_open|gfx_poll|gfx_present|gfx_pressed|gfx_rect|gfx_rgb|gfx_text|goto_xy|hide_cursor|home|http_fetch|http_get|http_post_as|http_post_json|http_put_json|http_remove|httpdelete|httpget|httppost|httpput|hypot|info|input|json_escape|json_get|json_path|json_safe|kbhit|key_down|key_pressed|length|listen|listen_tls|log_debug|log_error|log_info|log_warn|max|max_int|method|min|min_int|mouse_x|mouse_y|open_window|path|post|pow|present_window|print|radians|random|read_file|readfile|recv_tcp|replace|request_body|request_method|request_path|reset_color|resolve_host|respond|respond_status|rgb|round|route_get|route_post|secret|send_response|send_tcp|server_start|server_start_tls|server_stop|set|show_cursor|sin|size|sleep_ms|sqrt|str_contains|str_length|str_replace|str_split|str_to_int|strtoint|tcp_close|tcp_connect|tcp_recv|tcp_send|term_clear|term_color|term_goto|term_hide_cursor|term_home|term_reset|term_show_cursor|term_write|time_ms|to_int|unix_time_ms|wait|warn|window_focused|window_poll|write|write_file)\\b(?=\\s*\\()"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.fox" }
          }
        }
      ]
    },
    "variable-declarations": {
      "patterns": [
        {
          "match": "\\b(int|float|string|bool|array)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.type.primitive.fox" },
            "2": { "name": "variable.other.declaration.fox" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.fox",
          "match": "(\\+\\+|--|\\+=|-=|\\*=|/=|\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.comparison.fox",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.fox",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.fox",
          "match": "(=)"
        }
      ]
    },
    "delimiters": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.fox",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.fox",
          "match": ","
        },
        {
          "name": "punctuation.section.parens.fox",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.braces.fox",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.fox",
          "match": "[\\[\\]]"
        }
      ]
    }
  }
}
