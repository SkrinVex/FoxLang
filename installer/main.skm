include("transaction.skm");
using ui;

array setup_payload = json_decode(resource_read("manifest.json"));
string setup_version = setup_payload[0];
bool setup_maintenance = resource_read("installer-mode") == "maintenance";
bool setup_remove_requested = false;
string setup_target = path_join(os_user_dir("data"), "Skrumi");
array setup_args = os_args();
if (size(setup_args) == 2 && setup_args[0] == "--uninstall-gui") {
    setup_target = setup_args[1]; setup_remove_requested = true;
} else if (size(setup_args) > 0) {
    if ((size(setup_args) < 3 || size(setup_args) > 5) || setup_args[0] != "--headless") {
        print("Usage: installer --headless install|uninstall|recover DIRECTORY [--path] [--no-lsp]"); exit(2);
    }
    try {
        if (setup_args[1] == "recover") {
            if (size(setup_args) != 3) { fail("Recovery takes only a directory"); }
            tx_recover(setup_args[2]);
        }
        else {
            if (setup_args[1] != "install" && setup_args[1] != "uninstall") { fail("Unknown operation"); }
            if (setup_maintenance && setup_args[1] == "install") { fail("Download the full installer to install or update Skrumi"); }
            bool with_path = false;
            bool with_lsp = true;
            for (int i = 3; i < size(setup_args); i++) {
                if (setup_args[i] == "--path" && !with_path) { with_path = true; }
                else if (setup_args[i] == "--no-lsp" && with_lsp) { with_lsp = false; }
                else { fail("Unknown or duplicate option"); }
            }
            tx_include_lsp = with_lsp;
            tx_begin(setup_args[2], setup_args[1] == "uninstall", with_path);
            while (!tx_step()) { wait(1); }
        }
        print(tx_message);
    } catch (string error) {
        print(error);
        try { tx_cancel(); } catch (string recovery_error) { print("Recovery required: " + recovery_error); }
        tx_release(); exit(1);
    }
    exit(0);
}

int setup_font = load_font(resource_read("branding/font.ttf"));
ui_set_font(setup_font, 14);
UI_DIALOG_YES = "Yes"; UI_DIALOG_NO = "No"; UI_DIALOG_CANCEL = "Cancel";
int setup_logo = decode_image(resource_read("branding/logo.png"));
int setup_screen = 0;
if (setup_maintenance || setup_remove_requested) { setup_screen = 1; }
bool setup_running = false;
bool setup_confirm = false;
bool setup_recovery_confirm = false;
bool setup_uninstall = setup_maintenance || setup_remove_requested;
bool setup_path = true;
bool setup_lsp = true;
string setup_error = "";
bool setup_error_dialog = false;
int setup_scroll = 0;
void setup_failure(string error) {
    setup_error = error; setup_error_dialog = true;
    tx_note("Error: " + error);
    try { tx_cancel(); } catch (string recovery_error) { setup_error += "\nRecovery required: " + recovery_error; tx_note("Recovery required: " + recovery_error); }
    tx_release(); setup_running = false; setup_screen = 2;
}
// Layout uses logical coordinates; all drawing and hit-testing share this transform.
float setup_scale = 1;
int setup_left = 0;
int setup_top = 0;
int setup_px(float value) { return round(value * setup_scale); }
int setup_x(float value) { return setup_left + setup_px(value); }
int setup_y(float value) { return setup_top + setup_px(value); }
void setup_text(int x, int y, string text, int pixels, int color) {
    draw_font_text(setup_font, setup_x(x), setup_y(y), text, max(8, min(96, setup_px(pixels))), color);
}
void setup_rect(int x, int y, int width, int height, int color) {
    draw_rect(setup_x(x), setup_y(y), setup_px(width), max(1, setup_px(height)), color);
}
bool setup_button(string id, int x, int y, int width, int height, string label) {
    return ui_button(id, setup_x(x), setup_y(y), setup_px(width), setup_px(height), label);
}
bool setup_primary(string id, int x, int y, int width, int height, string label) {
    return ui_primary_button(id, setup_x(x), setup_y(y), setup_px(width), setup_px(height), label);
}
bool setup_checkbox(string id, int x, int y, string label, bool checked) {
    return ui_checkbox_box(id, setup_x(x), setup_y(y), max(8, setup_px(14)), label, checked);
}
ui_theme(false);
open_window(800, 580, "Skrumi Setup " + setup_version);
array setup_desktop = desktop_metrics();
float setup_initial_scale = min(setup_desktop[2], min(setup_desktop[0] / 800.0, setup_desktop[1] / 580.0));
setup_initial_scale = max(0.6, min(3, setup_initial_scale));
set_window_size(round(800 * setup_initial_scale), round(580 * setup_initial_scale));
set_window_resizable(true);
intercept_window_close(true);
try { setup_recovery_confirm = fs_exists_checked(path_absolute(setup_target) + ".skrumi-transaction"); }
catch (string error) { setup_error = error; setup_error_dialog = true; }
while (window_poll()) {
    if (window_width() < 480 || window_height() < 348) {
        set_window_size(max(480, window_width()), max(348, window_height()));
    }
    setup_scale = min(3, min(window_width() / 800.0, window_height() / 580.0));
    setup_left = (window_width() - setup_px(800)) / 2;
    setup_top = (window_height() - setup_px(580)) / 2;
    ui_set_font(setup_font, max(8, min(96, setup_px(14))));
    UI_SCROLL_STEP = setup_px(48);
    if (window_close_requested()) { setup_confirm = true; }
    clear_window(rgb(248, 249, 251));
    setup_rect(0, 0, 800, 112, UI_PANEL);
    draw_image_scaled(setup_logo, setup_x(24), setup_y(12), setup_px(88), setup_px(88));
    setup_text(132, 32, "Skrumi", 36, UI_TEXT);
    setup_text(134, 78, setup_version + "  /  " + os_platform() + " " + os_arch(), 14, UI_MUTED);
    setup_rect(32, 524, 736, 1, UI_BORDER);
    if (setup_screen == 0) {
        setup_text(48, 156, "Welcome to Skrumi", 26, UI_TEXT);
        setup_text(48, 216, "Native tools, scripting and graphical applications.", 18, UI_TEXT);
        setup_text(48, 266, "This offline installer includes the runtime and language server.", 14, UI_MUTED);
        setup_text(48, 292, "No existing Skrumi installation is required.", 14, UI_MUTED);
        if (setup_primary("continue", 620, 536, 148, 30, "Continue")) { setup_screen = 1; }
    } else if (setup_screen == 1) {
        setup_text(48, 144, "Installation options", 26, UI_TEXT);
        setup_text(48, 202, "Install directory (current user)", 14, UI_MUTED);
        setup_target = ui_text_field_box("directory", setup_x(48), setup_y(224), setup_px(704), setup_px(28), setup_target, "Directory");
        if (!setup_maintenance) {
            setup_lsp = setup_checkbox("lsp", 48, 284, "Language server (LSP); CLI/runtime is always included", setup_lsp);
        } else { setup_text(48, 284, "Skrumi maintenance and recovery", 14, UI_TEXT); }
        if (!setup_maintenance) {
            setup_uninstall = setup_checkbox("uninstall", 48, 326, "Remove this managed installation", setup_uninstall);
            setup_path = setup_checkbox("path", 48, 358, "Add to user PATH (new terminal/login)", setup_path);
        } else {
            setup_text(48, 330, "Remove the managed runtime and its PATH/OS registration.", 14, UI_TEXT);
            setup_text(48, 358, "This maintenance tool remains available for recovery.", 14, UI_MUTED);
        }
        setup_text(48, 390, "User projects and modified files are preserved.", 14, UI_MUTED);
        if (setup_button("recover", 48, 426, 204, 32, "Recover interrupted setup")) {
            try { tx_recover(setup_target); setup_error = ""; }
            catch (string error) { setup_error = error; setup_error_dialog = true; tx_release(); }
        }
        if (setup_error != "") { setup_text(48, 476, setup_error, 14, rgb(190, 40, 40)); }
        if (!setup_maintenance && setup_button("back", 462, 536, 144, 30, "Back")) { setup_screen = 0; }
        string action = "Install";
        if (setup_uninstall) { action = "Uninstall"; }
        if (setup_primary("install", 620, 536, 148, 30, action)) {
            setup_error = "";
            try {
                if (fs_exists_checked(path_absolute(setup_target) + ".skrumi-transaction")) { setup_recovery_confirm = true; }
                else { tx_include_lsp = setup_lsp; tx_begin(setup_target, setup_uninstall, setup_path); setup_running = true; setup_screen = 2; }
            }
            catch (string error) { setup_failure(error); }
        }
    } else {
        string heading = "Installing Skrumi";
        if (setup_uninstall) { heading = "Removing Skrumi"; }
        if (!setup_running && setup_error == "") { heading = "Completed"; }
        if (setup_error != "") { heading = "Installation stopped"; }
        setup_text(48, 144, heading, 26, UI_TEXT);
        float progress = tx_cursor;
        if (tx_phase == "publishing" || tx_phase == "verifying" || tx_phase == "integrated") { progress += size(tx_entries); }
        if (tx_phase == "committed") { progress = size(tx_entries) * 2 + 1; }
        ui_progress_bar(setup_x(48), setup_y(198), setup_px(704), setup_px(26), progress, 0, max(1, size(tx_entries) * 2 + 1), true);
        setup_text(48, 242, tx_message, 14, UI_TEXT);
        setup_scroll = ui_scroll_begin("log", setup_x(48), setup_y(274), setup_px(704), setup_px(166), setup_px(setup_scroll), setup_px(size(tx_log) * 18)) / setup_scale;
        for (int i = 0; i < size(tx_log); i++) { setup_text(52, 278 + i * 18 - setup_scroll, tx_log[i], 14, UI_MUTED); }
        ui_scroll_end();
        setup_text(48, 462, setup_target, 14, UI_MUTED);
        if (setup_error != "") { setup_text(48, 490, "See error details. Original files were restored when safe.", 14, rgb(190, 40, 40)); }
        if (!setup_running) {
            if (setup_button("options", 462, 536, 144, 30, "Options")) { setup_screen = 1; }
            if (setup_primary("finish", 620, 536, 148, 30, "Finish")) { close_window(); break; }
        } else if (setup_button("cancel", 620, 536, 148, 30, "Cancel")) { setup_confirm = true; }
        if (setup_running && !setup_confirm) {
            try { if (tx_step()) { setup_running = false; } }
            catch (string error) { setup_failure(error); }
        }
    }
    if (setup_error_dialog && !setup_confirm) {
        string error_answer = ui_dialog("error", "Setup error", setup_error, "error");
        if (error_answer != "pending") { setup_error_dialog = false; setup_screen = 1; }
    }
    if (tx_warning != "" && !setup_confirm && setup_error == "") {
        string warning_answer = ui_dialog("cleanup-warning", "Installation completed", tx_warning, "info");
        if (warning_answer != "pending") { tx_warning = ""; }
    }
    if (setup_recovery_confirm && !setup_confirm) {
        string recovery_answer = ui_dialog("recovery", "Interrupted installation", "An unfinished transaction was found. Restore the previous installation before continuing?", "confirm");
        if (recovery_answer == "yes") {
            try { tx_recover(setup_target); setup_error = ""; setup_screen = 1; }
            catch (string error) { setup_error = error; setup_error_dialog = true; tx_release(); setup_screen = 1; }
            setup_recovery_confirm = false;
        } else if (recovery_answer == "no" || recovery_answer == "cancel") { setup_recovery_confirm = false; }
    }
    if (setup_confirm) {
        string question = "Exit Skrumi Setup?";
        if (setup_running) { question = "Cancel and restore the previous installation?"; }
        string answer = ui_dialog("exit", "Skrumi Setup", question, "confirm");
        if (answer == "yes") {
            try { tx_cancel(); close_window(); break; }
            catch (string error) { setup_failure(error); setup_confirm = false; cancel_window_close(); }
        } else if (answer == "no" || answer == "cancel") { setup_confirm = false; cancel_window_close(); }
    }
    present_window();
}
free_image(setup_logo);
free_font(setup_font);
tx_release();
