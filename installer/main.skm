include("transaction.skm");
using ui;

array setup_payload = json_decode(resource_read("manifest.json"));
string setup_version = setup_payload[0];
string setup_target = path_join(os_user_dir("data"), "Skrumi");
array setup_args = os_args();
if (size(setup_args) > 0) {
    if ((size(setup_args) != 3 && size(setup_args) != 4) || setup_args[0] != "--headless") {
        print("Usage: installer --headless install|uninstall|recover DIRECTORY [--path]"); exit(2);
    }
    try {
        if (setup_args[1] == "recover") { tx_recover(setup_args[2]); }
        else {
            if (setup_args[1] != "install" && setup_args[1] != "uninstall") { fail("Unknown operation"); }
            bool with_path = size(setup_args) == 4;
            if (with_path && setup_args[3] != "--path") { fail("Unknown option"); }
            tx_begin(setup_args[2], setup_args[1] == "uninstall", with_path);
            while (!tx_step()) { wait(1); }
        }
        print(tx_message);
    } catch (string error) {
        print(error);
        try { tx_cancel(); } catch (string recovery_error) { print("Recovery required: " + recovery_error); }
        tx_release(); exit(1);
    }
    exit(0);
}

int setup_font = load_font(resource_read("branding/font.ttf"));
ui_set_font(setup_font, 14);
int setup_logo = decode_image(resource_read("branding/logo.png"));
int setup_screen = 0;
bool setup_running = false;
bool setup_confirm = false;
bool setup_recovery_confirm = false;
bool setup_uninstall = false;
bool setup_path = true;
string setup_error = "";
int setup_scroll = 0;
void setup_failure(string error) {
    setup_error = error;
    try { tx_cancel(); } catch (string recovery_error) { setup_error += "\nRecovery required: " + recovery_error; }
    tx_release(); setup_running = false; setup_screen = 2;
}
ui_theme(false);
open_window(800, 580, "Skrumi Setup " + setup_version);
intercept_window_close(true);
try { setup_recovery_confirm = fs_exists_checked(path_absolute(setup_target) + ".skrumi-transaction"); }
catch (string error) { setup_error = error; }
while (window_poll()) {
    if (window_close_requested()) { setup_confirm = true; }
    clear_window(rgb(248, 249, 251));
    draw_rect(0, 0, 800, 112, UI_PANEL);
    draw_image_scaled(setup_logo, 24, 12, 88, 88);
    draw_font_text(setup_font, 132, 32, "Skrumi", 36, UI_TEXT);
    draw_font_text(setup_font, 134, 78, setup_version + "  /  " + os_platform() + " " + os_arch(), 14, UI_MUTED);
    draw_rect(32, 524, 736, 1, UI_BORDER);
    if (setup_screen == 0) {
        draw_font_text(setup_font, 48, 156, "Welcome to Skrumi", 26, UI_TEXT);
        draw_font_text(setup_font, 48, 216, "Native tools, scripting and graphical applications.", 18, UI_TEXT);
        draw_font_text(setup_font, 48, 266, "This offline installer includes the runtime and language server.", 14, UI_MUTED);
        draw_font_text(setup_font, 48, 292, "No existing Skrumi installation is required.", 14, UI_MUTED);
        if (ui_primary_button("continue", 620, 536, 148, 30, "Continue")) { setup_screen = 1; }
    } else if (setup_screen == 1) {
        draw_font_text(setup_font, 48, 144, "Installation options", 26, UI_TEXT);
        draw_font_text(setup_font, 48, 202, "Install directory (current user)", 14, UI_MUTED);
        setup_target = ui_text_field("directory", 48, 224, 704, setup_target, "Directory");
        draw_font_text(setup_font, 48, 284, "Included: CLI/runtime, LSP, foxlang compatibility commands", 14, UI_TEXT);
        setup_uninstall = ui_checkbox("uninstall", 48, 326, "Remove this managed installation", setup_uninstall);
        setup_path = ui_checkbox("path", 48, 358, "Add to user PATH (new terminal/login)", setup_path);
        draw_font_text(setup_font, 48, 390, "User projects and modified files are preserved.", 14, UI_MUTED);
        if (ui_button("recover", 48, 426, 204, 32, "Recover interrupted setup")) {
            try { tx_recover(setup_target); setup_error = ""; }
            catch (string error) { setup_error = error; tx_release(); }
        }
        if (setup_error != "") { draw_font_text(setup_font, 48, 476, setup_error, 14, rgb(190, 40, 40)); }
        if (ui_button("back", 462, 536, 144, 30, "Back")) { setup_screen = 0; }
        string action = "Install";
        if (setup_uninstall) { action = "Uninstall"; }
        if (ui_primary_button("install", 620, 536, 148, 30, action)) {
            setup_error = "";
            try {
                if (fs_exists_checked(path_absolute(setup_target) + ".skrumi-transaction")) { setup_recovery_confirm = true; }
                else { tx_begin(setup_target, setup_uninstall, setup_path); setup_running = true; setup_screen = 2; }
            }
            catch (string error) { setup_failure(error); }
        }
    } else {
        string heading = "Installing Skrumi";
        if (setup_uninstall) { heading = "Removing Skrumi"; }
        if (!setup_running && setup_error == "") { heading = "Completed"; }
        if (setup_error != "") { heading = "Installation stopped"; }
        draw_font_text(setup_font, 48, 144, heading, 26, UI_TEXT);
        float progress = tx_cursor;
        if (tx_phase == "publishing" || tx_phase == "verifying" || tx_phase == "integrated") { progress += size(tx_entries); }
        if (tx_phase == "committed") { progress = size(tx_entries) * 2 + 1; }
        ui_progress_bar(48, 198, 704, 26, progress, 0, max(1, size(tx_entries) * 2 + 1), true);
        draw_font_text(setup_font, 48, 242, tx_message, 14, UI_TEXT);
        setup_scroll = ui_scroll_begin("log", 48, 274, 704, 166, setup_scroll, size(tx_log) * 18);
        for (int i = 0; i < size(tx_log); i++) { draw_font_text(setup_font, 52, 278 + i * 18 - setup_scroll, tx_log[i], 14, UI_MUTED); }
        ui_scroll_end();
        draw_font_text(setup_font, 48, 462, setup_target, 14, UI_MUTED);
        if (setup_error != "") { draw_font_text(setup_font, 48, 490, "See error details. Original files were restored when safe.", 14, rgb(190, 40, 40)); }
        if (!setup_running) {
            if (ui_button("options", 462, 536, 144, 30, "Options")) { setup_screen = 1; }
            if (ui_primary_button("finish", 620, 536, 148, 30, "Finish")) { close_window(); break; }
        } else if (ui_button("cancel", 620, 536, 148, 30, "Cancel")) { setup_confirm = true; }
        if (setup_running && !setup_confirm) {
            try { if (tx_step()) { setup_running = false; } }
            catch (string error) { setup_failure(error); }
        }
    }
    if (setup_error != "" && setup_screen == 2 && !setup_confirm) {
        string error_answer = ui_dialog("error", "Setup error", setup_error, "error");
        if (error_answer != "pending") { setup_screen = 1; }
    }
    if (setup_recovery_confirm && !setup_confirm) {
        string recovery_answer = ui_dialog("recovery", "Interrupted installation", "An unfinished transaction was found. Restore the previous installation before continuing?", "confirm");
        if (recovery_answer == "yes") {
            try { tx_recover(setup_target); setup_error = ""; setup_screen = 1; }
            catch (string error) { setup_error = error; tx_release(); setup_screen = 1; }
            setup_recovery_confirm = false;
        } else if (recovery_answer == "no" || recovery_answer == "cancel") { setup_recovery_confirm = false; }
    }
    if (setup_confirm) {
        string question = "Exit Skrumi Setup?";
        if (setup_running) { question = "Cancel and restore the previous installation?"; }
        string answer = ui_dialog("exit", "Skrumi Setup", question, "confirm");
        if (answer == "yes") {
            try { tx_cancel(); close_window(); break; }
            catch (string error) { setup_failure(error); setup_confirm = false; cancel_window_close(); }
        } else if (answer == "no" || answer == "cancel") { setup_confirm = false; cancel_window_close(); }
    }
    present_window();
}
free_image(setup_logo);
free_font(setup_font);
tx_release();
