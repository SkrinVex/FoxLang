# Only the small, reviewed standard library is embedded at CMake build time.
# User programs are packaged as data by `skrumi build`, never as generated C++.
file(GLOB std_sources CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/std/*.fox" "${CMAKE_CURRENT_SOURCE_DIR}/std/*.skm")
set(std_aliases "")
set(std_header "#pragma once\n#include <map>\n#include <string>\nnamespace foxlang {\ninline const std::map<std::string, std::string>& embeddedStdlib() {\nstatic const std::map<std::string, std::string> sources = {\n")
foreach(source IN LISTS std_sources)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    get_filename_component(name "${source}" NAME)
    get_filename_component(stem "${source}" NAME_WE)
    get_filename_component(extension "${source}" EXT)
    if(extension STREQUAL ".skm" AND EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/std/${stem}.fox")
        file(READ "${CMAKE_CURRENT_SOURCE_DIR}/std/${stem}.fox" legacy)
        set(expected "// Skrumi compatibility alias; implementation: ${stem}.skm.\ninclude(\"${stem}.skm\");\n")
        if(NOT legacy STREQUAL expected)
            message(FATAL_ERROR "Ambiguous standard module ${stem}: .fox must be a compatibility alias to .skm")
        endif()
        string(APPEND std_aliases "{\"std/${stem}.fox\", \"std/${stem}.skm\"},\n")
    endif()
    file(READ "${source}" contents HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "\\\\x\\1" contents "${contents}")
    string(APPEND std_header "{\"std/${name}\", \"${contents}\"},\n")
endforeach()
string(APPEND std_header "};\nreturn sources;\n}\ninline const std::map<std::string, std::string>& stdlibAliases() {\nstatic const std::map<std::string, std::string> aliases = {\n${std_aliases}};\nreturn aliases;\n}\n}\n")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/generated/EmbeddedStdlib.h.in" "${std_header}")
configure_file("${CMAKE_CURRENT_BINARY_DIR}/generated/EmbeddedStdlib.h.in"
               "${CMAKE_CURRENT_BINARY_DIR}/generated/EmbeddedStdlib.h" COPYONLY)
